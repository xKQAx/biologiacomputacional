# Copia este archivo a .env o exporta las variables en la shell.
# python-dotenv carga .env al arrancar y no pisa variables ya exportadas.
# No pongas secretos reales en el repositorio.

# true en local. En producción: false (si falta SECRET_KEY, el proceso no arranca).
DEBUG=true

# Obligatoria si DEBUG=false. En local, si la omites, Django genera una clave efímera
# y las sesiones se invalidan en cada arranque.
SECRET_KEY=cambia-esta-clave-solo-para-desarrollo

# Separados por coma. Obligatorio si DEBUG=false.
ALLOWED_HOSTS=127.0.0.1,localhost

# Vacío = SQLite (db.sqlite3 en la raíz del proyecto).
# Más adelante puede ser la URI de Supabase/Postgres, por ejemplo:
# DATABASE_URL=postgres://usuario:clave@db.ejemplo.supabase.co:5432/postgres?sslmode=require
# DATABASE_SSL_REQUIRE=true también pide TLS aunque la URI no traiga sslmode.
DATABASE_URL=
DATABASE_SSL_REQUIRE=false

# Si DEBUG=true y EMAIL_HOST_USER está vacío, el correo se imprime en la consola.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
# Contraseña de aplicación (16 caracteres, sin espacios), no la de inicio de sesión.
EMAIL_HOST_PASSWORD=

# Destino del formulario de contacto. Si no se define, se usa biocomp@udes.edu.co.
CONTACT_EMAIL=biocomp@udes.edu.co
